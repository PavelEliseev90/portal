	ТипДвигателя = "Бензин";
	КоробкаПередач = "Автомат";
	Привод = "Передний";
	Кузов = "Кроссовер";
	Цвет = "Белый";
	ЛоготипМарки = "";
	QRКод = "";
	Подразделение = "КорсАвто Серпухов";
	Сайт = "korsavto.ru";
	Телефон = "+7 (496) 000-00-00";
	ОбновитьПутиКартинокУслугПоУмолчанию();

КонецПроцедуры

#КонецОбласти

