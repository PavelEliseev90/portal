
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Сайт) Тогда
		Сайт = "korsavto.ru";
	КонецЕсли;

	Если ПустаяСтрока(БазовыйПутьКартинок) Тогда
		БазовыйПутьКартинок = "https://ah.kors-group.com/media/images";
	КонецЕсли;

	ОбновитьПутиКартинокУслугПоУмолчанию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)

	ТабДок = СформироватьТабличныйДокументНаСервере();
	Если ТабДок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТабДок.Напечатать(РежимИспользованияДиалогаПечати.Использовать);

КонецПроцедуры

&НаКлиенте
Процедура Предпросмотр(Команда)

	ТабДок = СформироватьТабличныйДокументНаСервере();
	Если ТабДок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТабДок.Показать("Ценник");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПример(Команда)
	ЗаполнитьПримерНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКартинкиУслуг(Команда)
	ОбновитьПутиКартинокУслугПоУмолчанию();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьТабличныйДокументНаСервере()

	Попытка
		ТабДок = Новый ТабличныйДокумент;
		НастроитьСтраницуЦенника(ТабДок);

		Строка = 1;
		Строка = ВывестиШапкуЦенника(ТабДок, Строка);
		Строка = ВывестиЗаголовокИЦену(ТабДок, Строка);
		Строка = ВывестиХарактеристики(ТабДок, Строка);
		Строка = ВывестиУслуги(ТабДок, Строка);
		Строка = УстановитьQRКод(ТабДок, Строка);
		Строка = ВывестиПодвал(ТабДок, Строка);

		Возврат ТабДок;
	Исключение
		Сообщить("Ошибка формирования печатной формы: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура НастроитьСтраницуЦенника(ТабДок)

	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ПолеСлева = 10;
	ТабДок.ПолеСправа = 10;
	ТабДок.ПолеСверху = 10;
	ТабДок.ПолеСнизу = 10;

	Для НомерКолонки = 1 По 8 Цикл
		ТабДок.Область(1, НомерКолонки, 1, НомерКолонки).ШиринаКолонки = 12;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВывестиШапкуЦенника(ТабДок, НачальнаяСтрока)

	Строка = НачальнаяСтрока;
	ЦветКорс = ЦветБрендаКорс();

	ОбластьЛево = ТабДок.Область(Строка, 1, Строка, 4);
	ОбластьЛево.Объединить();
	ОбластьПраво = ТабДок.Область(Строка, 5, Строка, 8);
	ОбластьПраво.Объединить();

	ДобавитьРисунокВОбласть(
		ТабДок,
		ПолучитьПутьЛоготипуШапки("logo_korsavto.png"),
		ОбластьЛево,
		148,
		40,
		"Лево");
	ДобавитьРисунокВОбласть(
		ТабДок,
		ПолучитьПутьЛоготипуШапки("logo_korsgroup.png"),
		ОбластьПраво,
		150,
		40,
		"Право");

	УстановитьВысотуСтроки(ТабДок, Строка, 14);

	Строка = Строка + 1;
	Линия = ТабДок.Область(Строка, 1, Строка, 8);
	Линия.Объединить();
	Линия.НижняяГраница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	Линия.ЦветРамки = ЦветКорс;
	УстановитьВысотуСтроки(ТабДок, Строка, 4);

	Возврат Строка + 1;

КонецФункции

&НаСервере
Функция ВывестиЗаголовокИЦену(ТабДок, НачальнаяСтрока)

	Строка = НачальнаяСтрока;
	ЦветКорс = ЦветБрендаКорс();

	Область = ТабДок.Область(Строка, 1, Строка, 8);
	Область.Объединить();
	Область.Текст = СокрЛП(Марка + " " + Модель);
	Область.Шрифт = Новый Шрифт(, 18, Истина);
	Область.ЦветТекста = ЦветКорс;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	УстановитьВысотуСтроки(ТабДок, Строка, 10);

	Строка = Строка + 1;
	Область = ТабДок.Область(Строка, 1, Строка, 8);
	Область.Объединить();
	Область.Текст = ФорматироватьЦену(Цена);
	Область.Шрифт = Новый Шрифт(, 22, Истина);
	Если ЦенаРезерв Тогда
		Область.ЦветТекста = Новый Цвет(245, 158, 11);
	Иначе
		Область.ЦветТекста = Новый Цвет(231, 76, 60);
	КонецЕсли;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	УстановитьВысотуСтроки(ТабДок, Строка, 12);

	Возврат Строка + 1;

КонецФункции

&НаСервере
Функция ВывестиХарактеристики(ТабДок, НачальнаяСтрока)

	Строка = НачальнаяСтрока;
	ЦветКорс = ЦветБрендаКорс();

	// Логотип марки слева
	ОбластьЛого = ТабДок.Область(Строка, 1, Строка + 5, 2);
	ОбластьЛого.Объединить();
	ОбластьЛого.РазмещениеТекста = РазмещениеТекста.Переносить;
	ОбластьЛого.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЛого.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	ДобавитьРисунокВОбласть(ТабДок, ЛоготипМарки, ОбластьЛого, 70, 70);

	Характеристики = Новый Массив;
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Год выпуска:", ГодВыпуска));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Пробег:", Пробег));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Двигатель:", Двигатель));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Тип двигателя:", ТипДвигателя));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Коробка передач:", КоробкаПередач));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Привод:", Привод));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Кузов:", Кузов));
	Характеристики.Добавить(Новый Структура("Метка, Значение", "Цвет:", Цвет));

	Индекс = 0;
	Пока Индекс < Характеристики.Количество() Цикл
		Элемент = Характеристики[Индекс];
		ОбластьМетка = ТабДок.Область(Строка, 3, Строка, 4);
		ОбластьМетка.Текст = Элемент.Метка;
		ОбластьМетка.Шрифт = Новый Шрифт(, 9);
		ОбластьМетка.ЦветТекста = Новый Цвет(102, 102, 102);

		ОбластьЗначение = ТабДок.Область(Строка, 5, Строка, 8);
		ОбластьЗначение.Объединить();
		ОбластьЗначение.Текст = СокрЛП(Элемент.Значение);
		ОбластьЗначение.Шрифт = Новый Шрифт(, 9, Истина);
		ОбластьЗначение.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		УстановитьВысотуСтроки(ТабДок, Строка, 6);

		Строка = Строка + 1;
		Индекс = Индекс + 1;
	КонецЦикла;

	Линия = ТабДок.Область(Строка, 1, Строка, 8);
	Линия.Объединить();
	Линия.НижняяГраница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Линия.ЦветРамки = ЦветКорс;
	УстановитьВысотуСтроки(ТабДок, Строка, 3);

	Возврат Строка + 1;

КонецФункции

&НаСервере
Функция ВывестиУслуги(ТабДок, НачальнаяСтрока)

	Строка = НачальнаяСтрока;
	КартинкиУслуг = Новый Массив;
	КартинкиУслуг.Добавить(КартинкаТрейдИн);
	КартинкиУслуг.Добавить(КартинкаСтрахование);
	КартинкиУслуг.Добавить(КартинкаЮрЛица);
	КартинкиУслуг.Добавить(КартинкаКредит);

	ОбластьФон = ТабДок.Область(Строка, 1, Строка + 2, 8);
	ОбластьФон.ЦветФона = Новый Цвет(248, 249, 250);

	КолонкиУслуг = Новый Массив;
	КолонкиУслуг.Добавить(1);
	КолонкиУслуг.Добавить(3);
	КолонкиУслуг.Добавить(5);
	КолонкиУслуг.Добавить(7);

	Индекс = 0;
	Пока Индекс < КартинкиУслуг.Количество() Цикл
		НомерКолонки = КолонкиУслуг[Индекс];
		Область = ТабДок.Область(Строка, НомерКолонки, Строка + 2, НомерКолонки + 1);
		Область.Объединить();
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Область.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		ДобавитьРисунокВОбласть(ТабДок, КартинкиУслуг[Индекс], Область, 60, 40);
		Индекс = Индекс + 1;
	КонецЦикла;

	УстановитьВысотуСтроки(ТабДок, Строка, 8);
	УстановитьВысотуСтроки(ТабДок, Строка + 1, 8);
	УстановитьВысотуСтроки(ТабДок, Строка + 2, 8);

	Возврат Строка + 4;

КонецФункции

&НаСервере
Функция УстановитьQRКод(ТабДок, НачальнаяСтрока)

	// =============================================================================
	// ЗАГЛУШКА QR-КОДА
	// Подставьте свою картинку в этой процедуре: путь к файлу, двоичные данные,
	// генератор штрихкода и т.д. Поле формы QRКод можно использовать как источник.
	//
	// Пример:
	//   КартинкаQR = ЗагрузитьКартинку(QRКод);
	//   Если КартинкаQR <> Неопределено Тогда
	//       ДобавитьРисунокВОбласть(ТабДок, QRКод, ОбластьQR, 80, 80);
	//   КонецЕсли;
	// =============================================================================

	Строка = НачальнаяСтрока;
	ЦветКорс = ЦветБрендаКорс();

	Линия = ТабДок.Область(Строка, 1, Строка, 8);
	Линия.Объединить();
	Линия.ВерхняяГраница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	Линия.ЦветРамки = ЦветКорс;
	УстановитьВысотуСтроки(ТабДок, Строка, 3);

	Строка = Строка + 1;
	ОбластьQR = ТабДок.Область(Строка, 3, Строка + 3, 6);
	ОбластьQR.Объединить();
	ОбластьQR.Текст = "[ QR-код ]";
	ОбластьQR.Шрифт = Новый Шрифт(, 10);
	ОбластьQR.ЦветТекста = Новый Цвет(150, 150, 150);
	ОбластьQR.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьQR.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	ЛинияРамки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ОбластьQR.ВерхняяГраница = ЛинияРамки;
	ОбластьQR.НижняяГраница = ЛинияРамки;
	ОбластьQR.ЛеваяГраница = ЛинияРамки;
	ОбластьQR.ПраваяГраница = ЛинияРамки;
	ОбластьQR.ЦветРамки = ЦветКорс;
	УстановитьВысотуСтроки(ТабДок, Строка, 10);
	УстановитьВысотуСтроки(ТабДок, Строка + 1, 10);
	УстановитьВысотуСтроки(ТабДок, Строка + 2, 10);
	УстановитьВысотуСтроки(ТабДок, Строка + 3, 10);

	Возврат Строка + 5;

КонецФункции

&НаСервере
Функция ВывестиПодвал(ТабДок, НачальнаяСтрока)

	Строка = НачальнаяСтрока;
	ЦветКорс = ЦветБрендаКорс();

	Линия = ТабДок.Область(Строка, 1, Строка, 8);
	Линия.Объединить();
	Линия.ВерхняяГраница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Линия.ЦветРамки = Новый Цвет(224, 224, 224);
	УстановитьВысотуСтроки(ТабДок, Строка, 3);

	Строка = Строка + 1;
	Область = ТабДок.Область(Строка, 1, Строка, 8);
	Область.Объединить();
	Область.Текст = "● " + СокрЛП(Подразделение)
		+ "     ● " + СокрЛП(Сайт)
		+ "     ● " + СокрЛП(Телефон);
	Область.Шрифт = Новый Шрифт(, 11, Истина);
	Область.ЦветТекста = ЦветКорс;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	УстановитьВысотуСтроки(ТабДок, Строка, 8);

	Возврат Строка + 1;

КонецФункции

&НаСервере
Процедура ПрименитьСтильШапки(Область, ЦветТекста)

	Область.Шрифт = Новый Шрифт(, 10, Истина);
	Область.ЦветТекста = ЦветТекста;
	Область.РазмещениеТекста = РазмещениеТекста.Переносить;

КонецПроцедуры

&НаСервере
Функция ЦветБрендаКорс()
	Возврат Новый Цвет(0, 42, 90);
КонецФункции

&НаСервере
Процедура УстановитьВысотуСтроки(ТабДок, НомерСтроки, Высота)
	ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).ВысотаСтроки = Высота;
КонецПроцедуры

&НаСервере
Процедура ДобавитьРисунокВОбласть(ТабДок, ПутьККартинке, ОбластьЯчейки, Ширина, Высота, Выравнивание = "Лево")

	Картинка = ЗагрузитьКартинку(ПутьККартинке);
	Если Картинка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = Картинка;
	Рисунок.Верх = ОбластьЯчейки.Верх + 2;
	Если Выравнивание = "Право" Тогда
		Рисунок.Лево = ОбластьЯчейки.Лево + ОбластьЯчейки.Ширина - Ширина - 2;
	Иначе
		Рисунок.Лево = ОбластьЯчейки.Лево + 2;
	КонецЕсли;
	Рисунок.Ширина = Ширина;
	Рисунок.Высота = Высота;

КонецПроцедуры

&НаСервере
Функция ПолучитьПутьЛоготипуШапки(ИмяФайла)

	База = СокрЛП(БазовыйПутьКартинок);
	Если ПустаяСтрока(База) Тогда
		Возврат "";
	КонецЕсли;

	Если Прав(База, 1) = "/" Или Прав(База, 1) = "\" Тогда
		База = Лев(База, СтрДлина(База) - 1);
	КонецЕсли;

	Разделитель = ?(СтрНайти(База, "\") > 0, "\", "/");
	Возврат База + Разделитель + ИмяФайла;

КонецФункции

&НаСервере
Функция ЗагрузитьКартинку(Адрес)

	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Файл = Новый Файл(Адрес);
		Если Файл.Существует() Тогда
			Возврат Новый Картинка(Адрес);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ФорматироватьЦену(ЗначениеЦены)

	Если ЗначениеЦены = 0 Или ЗначениеЦены = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(ЗначениеЦены, "ЧДЦ=0; ЧРГ=' '; ЧН=0; ЧГ=") + " ₽";

КонецФункции

&НаСервере
Процедура ОбновитьПутиКартинокУслугПоУмолчанию()

	База = СокрЛП(БазовыйПутьКартинок);
	Если ПустаяСтрока(База) Тогда
		Возврат;
	КонецЕсли;

	Если Прав(База, 1) = "/" Или Прав(База, 1) = "\" Тогда
		База = Лев(База, СтрДлина(База) - 1);
	КонецЕсли;

	Если ПустаяСтрока(КартинкаТрейдИн) Тогда
		КартинкаТрейдИн = База + "/tradein.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаСтрахование) Тогда
		КартинкаСтрахование = База + "/strah.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаЮрЛица) Тогда
		КартинкаЮрЛица = База + "/yur.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаКредит) Тогда
		КартинкаКредит = База + "/credit.png";
	КонецЕсли;

КонецПроцедуры

