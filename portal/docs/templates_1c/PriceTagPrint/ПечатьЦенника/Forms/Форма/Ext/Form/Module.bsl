
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Сайт) Тогда
		Сайт = "korsavto.ru";
	КонецЕсли;

	Если ПустаяСтрока(БазовыйПутьКартинок) Тогда
		БазовыйПутьКартинок = "https://ah.kors-group.com/media/images";
	КонецЕсли;

	ОбновитьПутиКартинокУслугПоУмолчанию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)

	ИмяФайла = "";
	СформироватьИСохранитьHTMLНаСервере(ИмяФайла);

	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	ЗапуститьПриложение(ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура Предпросмотр(Команда)

	ИмяФайла = "";
	СформироватьИСохранитьHTMLНаСервере(ИмяФайла);

	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	ЗапуститьПриложение(ИмяФайла);
	ПоказатьПредупреждение(, "Откроется браузер. Для печати нажмите Ctrl+P и выберите принтер.");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПример(Команда)
	ЗаполнитьПримерНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКартинкиУслуг(Команда)
	ОбновитьПутиКартинокУслугПоУмолчанию();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьИСохранитьHTMLНаСервере(ИмяФайла)

	ИмяФайла = "";

	Попытка
		ТекстHTML = СформироватьHTML();
	Исключение
		Сообщить("Ошибка формирования HTML: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ИмяФайла = ПолучитьИмяВременногоФайла("html");

	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.Записать(ТекстHTML);
	Запись.Закрыть();

КонецПроцедуры

&НаСервере
Функция СформироватьHTML()

	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетЦенника");
	ТекстHTML = Макет.ПолучитьТекст();

	Параметры = ПолучитьПараметрыПечати();
	ТекстHTML = ПодставитьПараметры(ТекстHTML, Параметры);
	ТекстHTML = ПрименитьСтильЦеныРезерв(ТекстHTML, ЦенаРезерв);
	ТекстHTML = СкрытьПустойQR(ТекстHTML, Параметры.QRКод);

	Возврат ТекстHTML;

КонецФункции

&НаСервере
Функция ПолучитьПараметрыПечати()

	Параметры = Новый Структура;

	Параметры.Вставить("Марка", СокрЛП(Марка));
	Параметры.Вставить("Модель", СокрЛП(Модель));
	Параметры.Вставить("Цена", ФорматироватьЦену(Цена));
	Параметры.Вставить("ГодВыпуска", СокрЛП(ГодВыпуска));
	Параметры.Вставить("Пробег", СокрЛП(Пробег));
	Параметры.Вставить("Двигатель", СокрЛП(Двигатель));
	Параметры.Вставить("ТипДвигателя", СокрЛП(ТипДвигателя));
	Параметры.Вставить("КоробкаПередач", СокрЛП(КоробкаПередач));
	Параметры.Вставить("Привод", СокрЛП(Привод));
	Параметры.Вставить("Кузов", СокрЛП(Кузов));
	Параметры.Вставить("Цвет", СокрЛП(Цвет));
	Параметры.Вставить("ЛоготипМарки", СокрЛП(ЛоготипМарки));
	Параметры.Вставить("QRКод", СокрЛП(QRКод));
	Параметры.Вставить("КартинкаТрейдИн", СокрЛП(КартинкаТрейдИн));
	Параметры.Вставить("КартинкаСтрахование", СокрЛП(КартинкаСтрахование));
	Параметры.Вставить("КартинкаЮрЛица", СокрЛП(КартинкаЮрЛица));
	Параметры.Вставить("КартинкаКредит", СокрЛП(КартинкаКредит));
	Параметры.Вставить("Подразделение", СокрЛП(Подразделение));
	Параметры.Вставить("Сайт", СокрЛП(Сайт));
	Параметры.Вставить("Телефон", СокрЛП(Телефон));

	Возврат Параметры;

КонецФункции

&НаСервере
Функция ПодставитьПараметры(ТекстHTML, Параметры)

	Результат = ТекстHTML;

	Для Каждого КлючИЗначение Из Параметры Цикл
		Результат = СтрЗаменить(Результат, "[" + КлючИЗначение.Ключ + "]", КлючИЗначение.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ФорматироватьЦену(ЗначениеЦены)

	Если ЗначениеЦены = 0 Или ЗначениеЦены = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(ЗначениеЦены, "ЧДЦ=0; ЧРГ=' '; ЧН=0; ЧГ=") + " ₽";

КонецФункции

&НаСервере
Функция ПрименитьСтильЦеныРезерв(ТекстHTML, ЭтоРезерв)

	Если Не ЭтоРезерв Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	Возврат СтрЗаменить(ТекстHTML, "class=""price-tag-price""", "class=""price-tag-price price-tag-price-reserved""");

КонецФункции

&НаСервере
Функция СкрытьПустойQR(ТекстHTML, QRКод)

	Если Не ПустаяСтрока(QRКод) Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	// Скрываем блок QR, если код не задан
	Возврат СтрЗаменить(ТекстHTML, "class=""price-tag-footer""", "class=""price-tag-footer"" style=""display:none""");

КонецФункции

&НаСервере
Процедура ОбновитьПутиКартинокУслугПоУмолчанию()

	База = СокрЛП(БазовыйПутьКартинок);
	Если ПустаяСтрока(База) Тогда
		Возврат;
	КонецЕсли;

	Если Прав(База, 1) = "/" Или Прав(База, 1) = "\" Тогда
		База = Лев(База, СтрДлина(База) - 1);
	КонецЕсли;

	Если ПустаяСтрока(КартинкаТрейдИн) Тогда
		КартинкаТрейдИн = База + "/tradein.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаСтрахование) Тогда
		КартинкаСтрахование = База + "/strah.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаЮрЛица) Тогда
		КартинкаЮрЛица = База + "/yur.png";
	КонецЕсли;
	Если ПустаяСтрока(КартинкаКредит) Тогда
		КартинкаКредит = База + "/credit.png";
	КонецЕсли;

КонецПроцедуры

