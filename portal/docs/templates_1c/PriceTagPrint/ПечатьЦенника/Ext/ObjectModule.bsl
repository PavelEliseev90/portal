
#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);
	ПараметрыРегистрации.Вставить("Наименование", "Печать ценника КорсАвто (HTML)");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Печать ценника автомобиля с пробегом по HTML-макету портала КорсАвто. "
		+ "Заполните параметры на форме и нажмите «Печать» — откроется браузер с предпросмотром (Ctrl+P).");

	Возврат ПараметрыРегистрации;

КонецФункции

