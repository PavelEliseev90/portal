// Пример подстановки параметров в макет price_tag_print.html из 1С
// Скопируйте фрагмент в свою обработку / общий модуль и адаптируйте под ваш объект.

Функция СформироватьHTMLЦенника(ДанныеАвто) Экспорт

	ПутьКМакету = "C:\path\to\price_tag_print.html"; // укажите путь к файлу макета
	Чтение = Новый ЧтениеТекста(ПутьКМакету, КодировкаТекста.UTF8);
	ТекстHTML = Чтение.Прочитать();
	Чтение.Закрыть();

	Замены = Новый Соответствие;
	Замены.Вставить("[Марка]", ДанныеАвто.Марка);
	Замены.Вставить("[Модель]", ДанныеАвто.Модель);
	Замены.Вставить("[Цена]", Формат(ДанныеАвто.Цена, "ЧДЦ=0; ЧРГ=' '; ЧН=0") + " ₽");
	Замены.Вставить("[ГодВыпуска]", Формат(ДанныеАвто.ГодВыпуска, "ЧГ=0"));
	Замены.Вставить("[Пробег]", Формат(ДанныеАвто.Пробег, "ЧДЦ=0; ЧРГ=' '; ЧН=0") + " км");
	Замены.Вставить("[Двигатель]", ДанныеАвто.Двигатель);
	Замены.Вставить("[ТипДвигателя]", ДанныеАвто.ТипДвигателя);
	Замены.Вставить("[КоробкаПередач]", ДанныеАвто.КоробкаПередач);
	Замены.Вставить("[Привод]", ДанныеАвто.Привод);
	Замены.Вставить("[Кузов]", ДанныеАвто.Кузов);
	Замены.Вставить("[Цвет]", ДанныеАвто.Цвет);
	Замены.Вставить("[ЛоготипМарки]", ДанныеАвто.ЛоготипМарки);
	Замены.Вставить("[QRКод]", ДанныеАвто.QRКод);
	Замены.Вставить("[КартинкаТрейдИн]", ДанныеАвто.КартинкаТрейдИн);
	Замены.Вставить("[КартинкаСтрахование]", ДанныеАвто.КартинкаСтрахование);
	Замены.Вставить("[КартинкаЮрЛица]", ДанныеАвто.КартинкаЮрЛица);
	Замены.Вставить("[КартинкаКредит]", ДанныеАвто.КартинкаКредит);
	Замены.Вставить("[Подразделение]", "КорсАвто " + ДанныеАвто.ГородПодразделения);
	Замены.Вставить("[Сайт]", "korsavto.ru");
	Замены.Вставить("[Телефон]", ДанныеАвто.Телефон);

	Для Каждого КлючИЗначение Из Замены Цикл
		ТекстHTML = СтрЗаменить(ТекстHTML, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Возврат ТекстHTML;

КонецФункции

// Печать: сохранить во временный файл и открыть в браузере
Процедура ПечатьЦенника(ДанныеАвто) Экспорт

	ТекстHTML = СформироватьHTMLЦенника(ДанныеАвто);
	ИмяФайла = ПолучитьИмяВременногоФайла("html");
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.Записать(ТекстHTML);
	Запись.Закрыть();
	ЗапуститьПриложение(ИмяФайла);

КонецПроцедуры
