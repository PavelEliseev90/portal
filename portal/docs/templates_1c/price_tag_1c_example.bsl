// Пример формирования ценника через табличный документ 1С
// Логика совпадает с внешней обработкой PriceTagPrint (Module.bsl формы).

Функция СформироватьТабличныйДокументЦенника(ДанныеАвто) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;

	Строка = 1;

	// Шапка
	Область = ТабДок.Область(Строка, 1, Строка, 8);
	Область.Объединить();
	Область.Текст = ДанныеАвто.Марка + " " + ДанныеАвто.Модель;
	Область.Шрифт = Новый Шрифт(, 18, Истина);
	Строка = Строка + 1;

	// Цена
	Область = ТабДок.Область(Строка, 1, Строка, 8);
	Область.Объединить();
	Область.Текст = Формат(ДанныеАвто.Цена, "ЧДЦ=0; ЧРГ=' '; ЧН=0") + " ₽";
	Область.Шрифт = Новый Шрифт(, 22, Истина);
	Строка = Строка + 1;

	// Характеристики, услуги, подвал — см. полный код в PriceTagPrint/.../Module.bsl

	// QR-код: заглушка — доработайте под свою генерацию
	ОбластьQR = ТабДок.Область(Строка, 3, Строка + 3, 6);
	ОбластьQR.Объединить();
	ОбластьQR.Текст = "[ QR-код ]";
	// Пример подстановки:
	// Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	// Рисунок.Картинка = Новый Картинка(ДанныеАвто.ПутьКQR);

	Возврат ТабДок;

КонецФункции

Процедура ПечатьЦенника(ДанныеАвто) Экспорт

	ТабДок = СформироватьТабличныйДокументЦенника(ДанныеАвто);
	ТабДок.Показать("Ценник");

КонецПроцедуры
